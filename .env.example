# Copiez ce fichier en .env et remplissez vos vraies valeurs.
# Le .env NE DOIT JAMAIS etre versionne (il est dans .gitignore).

# Chaine de connexion Atlas (Database > Connect > Drivers)
# Exemple : mongodb+srv://user:password@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb+srv://REMPLACER_USER:REMPLACER_PASSWORD@cluster0.xxxxx.mongodb.net

# Nom de la base et des collections
DB_NAME=dvf
COLL_MUTATIONS=mutations
COLL_COMMUNES=communes
